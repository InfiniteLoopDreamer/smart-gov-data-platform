# ============================================
# 智慧政务大数据平台 - Git 忽略规则
# ============================================

# ---- Python 运行时 ----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
dist/
build/
*.egg
.wheel/

# ---- 虚拟环境 ----
.venv/
venv/
env/
ENV/
env.bak/

# ---- 数据目录（运行 python generate_data.py 后自动生成）----
data/*
!data/.gitkeep
*.sqlite3
*.sqlite
*.db

# ---- Streamlit ----
.streamlit/secrets.toml

# ---- IDE / 编辑器 ----
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject

# ---- 测试与覆盖率 ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
noxfile.py

# ---- 系统文件 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- 前端 ----
frontend/node_modules/
frontend/dist/
node_modules/

# ---- 环境变量 / 密钥 ----
.env
.env.*
!.env.example

# ---- 根目录临时截图（正式截图在 docs/screenshots）----
/screenshot.png
/screenshot_bottom.png
